# MongoDB Atlas connection string used by work/api.py and work/ocrutlis.py
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Nanonets OCR API key used by work/extract.py
NANONETS_API_KEY=

# Path to the tesseract binary (defaults to "tesseract" on PATH)
TESSERACT_CMD=tesseract

# Set to "true" to enable Flask debug mode locally. Never enable in production.
FLASK_DEBUG=false
